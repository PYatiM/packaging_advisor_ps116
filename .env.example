# Copy this file to .env and fill in your credentials

# Runtime environment: development | production
ENVIRONMENT=development

# Google Gemini API configuration (optional; deterministic fallback works without keys)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Serverless Inference API (for Qwen small models & custom repos)
# Supported small models: Qwen/Qwen2.5-1.5B-Instruct, Qwen/Qwen2.5-3B-Instruct, Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_API_KEY=your-huggingface-token
HUGGINGFACE_MODEL=Qwen/Qwen2.5-3B-Instruct

# Relational database (SQLite default; PostgreSQL URLs also supported)
DATABASE_URL=sqlite:///./data/packaging_advisor.db

# Configurable Indian freight base rate overrides (INR / kg)
AIR_BASE_RATE_PER_KG=60.0
SURFACE_BASE_RATE_PER_KG=15.0
PTL_BASE_RATE_PER_KG=9.0
